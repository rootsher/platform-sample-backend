{
  "name": "platform-sample-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --import ./src/telemetry.ts src/server.ts",
    "start": "node --import ./dist/telemetry.js dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate --migrations-dir migrations --no-verbose",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/otel": "^0.21.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prometheus-io/client": "^0.16.1",
    "fastify": "^5.12.5",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}

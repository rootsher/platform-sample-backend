{
  "name": "platform-sample-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate --migrations-dir migrations --no-verbose",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "fastify": "^5.11.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
